AISSTREAM_API_KEY="your_aisstream_api_key_here"

# Maritime Bounding Box Presets:
# - ALL_INDIA      : Full Indian coastline (Arabian Sea & Bay of Bengal: [[6.0, 68.0], [24.0, 90.0]])
# - MUMBAI_GUJARAT : High-density tanker & container corridor (JNPT, Mumbai, Kandla, Mundra)
# - CHENNAI_VIZAG  : East Coast corridor (Chennai, Ennore, Kakinada, Vizag)
# - KANDLA_MUNDRA  : Gulf of Kutch ports
# - STRAIT_OF_HORMUZ: Gulf & Strait of Hormuz
# - MALACCA_STRAIT : Singapore & Malacca Strait
BOUNDING_BOX_PRESET="ALL_INDIA"

# Optional Custom Coordinates format: "min_lat,min_lon,max_lat,max_lon"
# CUSTOM_BOUNDING_BOX="18.0,68.0,23.5,74.0"

# Set to "false" by default for 100% pure live AIS data (no fallback seed vessels)
ENABLE_SAMPLE_SEEDS="false"
